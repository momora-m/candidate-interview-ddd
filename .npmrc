# Install only package versions published at least 7 days ago.
# Requires npm >= 11.10.0. The value is a number of days.
# https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age
min-release-age=7

# Fail `npm audit` on moderate and above when a level is not passed explicitly.
audit=true
audit-level=moderate
